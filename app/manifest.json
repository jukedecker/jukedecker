{
  "id": "/jukedecker/app/",
  "name": "JukeDecker",
  "short_name": "JukeDecker",
  "description": "PlayDecker und Jukeboxer für Handy und Tablet - spielt Playlisten aus einem Mobil-Paket.",
  "lang": "de",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "landscape",
  "background_color": "#0f1c22",
  "theme_color": "#0b1418",
  "icons": [
    { "src": "symbol-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "symbol-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "symbol-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./teilen-empfang",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "datei", "accept": ["application/json", ".json"] }
      ]
    }
  }
}
